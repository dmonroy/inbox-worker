{
  "name": "inbox-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "postal-mime": "^2.7.5"
  },
  "bin": {
    "inbox-worker": "./dist/cli.js"
  }
}
