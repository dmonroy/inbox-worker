{
  "name": "inbox-worker-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "inbox-worker migrate --remote",
    "db:migrate:local": "inbox-worker migrate --local",
    "deploy": "npm run db:migrate && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "inbox-worker": "file:.."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.114.0"
  }
}
